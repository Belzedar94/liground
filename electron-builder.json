{
  "productName": "liground",
  "appId": "com.example.yourapp",
  "directories": {
    "output": "build"
  },
  "files": [
    "dist/electron/**/*"
  ],
  "asarUnpack":[
    "static"
  ],
  "extraResources": [
    {
      "from": "engines",
      "to": "engines"
    }
  ],
  "extraFiles":[
    {
      "from": "static",
      "to": "static"
    }
  ],
  "dmg": {
    "contents": [
      {
        "x": 410,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 130,
        "y": 150,
        "type": "file"
      }
    ]
  },
  "mac": {
    "icon": "build/icons/icon.icns",
    "target": ["zip"],
    "artifactName": "LiGround-Spell-${version}-mac-${arch}.${ext}"
  },
  "win": {
    "icon": "build/icons/icon.ico",
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "LiGround-Spell-${version}-win-setup.${ext}"
  },
  "portable": {
    "artifactName": "LiGround-Spell-${version}-win-portable.${ext}"
  },
  "linux": {
    "icon": "build/icons",
    "target": ["AppImage"],
    "category": "Game"
  },
  "appImage": {
    "executableArgs": [
      "--no-sandbox"
    ],
    "artifactName": "LiGround-Spell-${version}-linux-${arch}.${ext}"
  }
}
